# ---- Anthropic (agent LLM) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# ---- CockroachDB Cloud: direct SQL connection ----
# Used ONLY by db/schema.sql + db/seed_data.py (ops/seeding, not the agent's runtime path).
# Get this from Cloud Console > your cluster > Connect.
COCKROACHDB_CONNECTION_STRING=postgresql://<user>:<password>@<host>:26257/<database>?sslmode=verify-full
# Note: if `psql -f db/schema.sql` complains about a missing root.crt, run it with
# an appended `&sslrootcert=system` on the URL (psql only — db/seed_data.py handles
# this in code via certifi instead, since psycopg2-binary's bundled libpq doesn't
# integrate with the macOS system keychain the way psql's does).

# ---- CockroachDB Cloud: Managed MCP Server ----
# Used by the agent at runtime (crdb_mcp/mcp_client.py) for all structured + vector queries.
# This is a SHARED endpoint (same URL for every cluster) — two headers identify and
# authorize the request:
#   mcp-cluster-id : which cluster to talk to (not secret — safe to commit as a default)
#   Authorization  : Bearer <service account API key> (secret — do NOT commit)
# The `claude mcp add ...` command only registers this server for Claude Code's own
# interactive/OAuth use — it does NOT provide credentials for this headless backend.
# Create a separate Service Account in Cloud Console (Access Management > Service
# Accounts), grant it a Cloud RBAC role scoped to this cluster (with write access, since
# log_visit/log_message insert rows), and generate an API key for CRDB_MCP_AUTH_TOKEN.
CRDB_MCP_SERVER_URL=https://cockroachlabs.cloud/mcp
CRDB_MCP_CLUSTER_ID=<your-cluster-id>
CRDB_MCP_AUTH_TOKEN=

# ---- AWS (Bedrock Titan embeddings) ----
# Static IAM user access key with bedrock:InvokeModel permission. Must be a region where
# Titan Text Embeddings V2 is available (us-east-1 or us-west-2 — NOT us-west-1).
AWS_REGION=us-west-2
BEDROCK_ACCESSKEY=
BEDROCK_SECRET_ACCESSKEY=

# ---- Mock demo user ----
# Must match the user_id inserted by db/seed_data.py.
MOCK_USER_ID=11111111-1111-1111-1111-111111111111
